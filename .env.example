# App → overnight API (use your Mac LAN IP for a physical iPhone)
# Example: EXPO_PUBLIC_OVERNIGHT_URL=http://192.168.1.20:8787
EXPO_PUBLIC_OVERNIGHT_URL=http://localhost:8787

# Server-only (never EXPO_PUBLIC_) — used by `npm run overnight:server`
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=8787
