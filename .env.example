# App → overnight API (use your Mac LAN IP for a physical iPhone)
# Example: EXPO_PUBLIC_OVERNIGHT_URL=http://192.168.1.20:8787
EXPO_PUBLIC_OVERNIGHT_URL=http://localhost:8787

# Server-only (never EXPO_PUBLIC_) — used by `npm run overnight:server`
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=8787

# Morning brief email (depth layer). Without RESEND_API_KEY, writes server/outbox/*.json
BRIEF_TO=
# RESEND_API_KEY=
# BRIEF_FROM=Lanyard <onboarding@resend.dev>

# Gmail OAuth + send (see docs/CONNECT_GMAIL.md — don’t skip steps)
# Create a Web OAuth client in Google Cloud; redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For iPhone dogfood use your LAN IP, not localhost:
# GOOGLE_REDIRECT_URI=http://192.168.1.20:8787/oauth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/google/callback
