APIFY_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google-sa.json
GOOGLE_SHARE_WITH_EMAIL=
SPREADSHEET_ID=
DRY_RUN=true
DEFAULT_OWNER=Nate
# Stage 1: drop posts with fewer comments than this (when count is known)
MIN_COMMENT_COUNT=3
COMPANY_FETCH_LIMIT=50
# Tier1Firms → Tier1People (people-at-company) — LinkedIn pacing guardrails
MAX_EMPLOYEES_PER_FIRM=25
MAX_EMPLOYEES_PER_FIRM_HARD_CAP=50
MAX_FIRMS_PER_PEOPLE_RUN=1
PEOPLE_FIRM_DELAY_SECONDS=90
# Same firm: skip re-scrape for this many days (default 180 ≈ 6 months; use 365 for yearly)
PEOPLE_FIRM_COOLDOWN_DAYS=180
PEOPLE_AUTO_DEACTIVATE=true
# Influencers harvest: after a successful run, set Active=FALSE (re-enable manually to run again)
INFLUENCER_AUTO_DEACTIVATE=true

# BetterContact — leave OFF until you've bake-off'd ~100 leads in the UI
ENABLE_ENRICHMENT=false
BETTERCONTACT_API_KEY=
